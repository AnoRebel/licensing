{
  "name": "licensing-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo: TypeScript and Go ports of laravel-licensing, plus Nuxt admin UI.",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "typescript",
    "admin",
    "examples/ts",
    "tools/fixture-generator",
    "tools/interop"
  ],
  "scripts": {
    "check": "biome check .",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "build": "bun run --filter='@anorebel/licensing' build",
    "test": "bun run --filter='@anorebel/licensing' test",
    "typecheck": "bun run --filter='@anorebel/licensing' typecheck",
    "version:sync": "node scripts/sync-versions.mjs",
    "version:check": "node scripts/sync-versions.mjs --check",
    "docs:check": "node scripts/check-doc-versions.mjs",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "26.6.6",
    "lefthook": "2.2.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  }
}
